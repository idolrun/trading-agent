# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- PostgreSQL container (compose.yaml) ---
POSTGRES_PASSWORD=change-me-superuser        # local superuser, container admin only
POSTGRES_PORT=5432
TRADING_OWNER_PASSWORD=change-me-owner       # role trading_owner: migrations, graph setup
TRADING_APP_PASSWORD=change-me-app           # role trading_app: running service (DML only)

# --- Backend (app/config.py); passwords must match the ones above ---
DATABASE_URL=postgresql+psycopg://trading_app:change-me-app@127.0.0.1:5432/trading
DATABASE_OWNER_URL=postgresql+psycopg://trading_owner:change-me-owner@127.0.0.1:5432/trading
TEST_DATABASE_URL=postgresql+psycopg://trading_app:change-me-app@127.0.0.1:5432/trading_test
TEST_DATABASE_OWNER_URL=postgresql+psycopg://trading_owner:change-me-owner@127.0.0.1:5432/trading_test
DB_POOL_SIZE=10
