# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- PostgreSQL container (compose.yaml) ---
POSTGRES_PASSWORD=change-me-superuser        # local superuser, container admin only
POSTGRES_PORT=5432
TRADING_OWNER_PASSWORD=change-me-owner       # role trading_owner: migrations, graph setup
TRADING_APP_PASSWORD=change-me-app           # role trading_app: running service (DML only)

# --- Backend (app/config.py); passwords must match the ones above ---
DATABASE_URL=postgresql+psycopg://trading_app:change-me-app@127.0.0.1:5432/trading
DATABASE_OWNER_URL=postgresql+psycopg://trading_owner:change-me-owner@127.0.0.1:5432/trading
TEST_DATABASE_URL=postgresql+psycopg://trading_app:change-me-app@127.0.0.1:5432/trading_test
TEST_DATABASE_OWNER_URL=postgresql+psycopg://trading_owner:change-me-owner@127.0.0.1:5432/trading_test
DB_POOL_SIZE=10

# --- Password auth (F009). Dashboard origin = the only origin allowed to change state ---
DASHBOARD_ORIGIN=http://localhost:3000
# SESSION_IDLE_MINUTES=60
# SESSION_ABSOLUTE_HOURS=12
# STEP_UP_WINDOW_S=120
# AUTH_RATE_LIMIT_PER_MIN=10

# --- Message API webhook (F011): shared HMAC secret for POST /ingest and /ingest/heartbeat ---
INGEST_HMAC_SECRET=change-me-long-random-hex

# --- Discord listener: user-account token (selfbot; ToS risk, use a throwaway account).
# Unset = listener off. Watched channels are managed on the dashboard Discord page. ---
# DISCORD_TOKEN=

# --- Laya fallback (only when Jev gave no answer; switch on in Config). Checkpoint downloaded
# from Hugging Face on first use. ---
# LAYA_MODEL=aac6fef/laya-mlx

# --- Broker and market data (F051). Default fake. Alpaca paper = paper trading (US stocks and
# ETF options only: no SPX/SPXW). Keys from the paper account on app.alpaca.markets. One key pair
# per process. Free data: stocks IEX, options indicative (delayed). ---
# BROKER_ADAPTER=alpaca
# MARKETDATA_ADAPTER=alpaca
# APCA_API_BASE_URL=https://paper-api.alpaca.markets   # api.alpaca.markets (live) needs ENVIRONMENT=production
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_STOCK_FEED=iex        # sip needs a paid plan
# ALPACA_OPTIONS_FEED=indicative   # opra needs a paid plan
# ALPACA_POLL_INTERVAL_S=5

# --- Interpretation (F026). Dev/demo only: ParsedSignals JSON per message id; ignored in
# production (no interpreter until F035 -> raw review cards) ---
# INTERPRETATION_FIXTURES_DIR=backend/tests/fixtures/interpretations

# --- Web Push (F029). Unset = push disabled (SSE still works). Generate a VAPID key pair,
# e.g. `uv run vapid --gen` (py-vapid, installed with pywebpush) ---
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- LLM providers (F031). A missing key disables that provider (alert at startup) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_COMPAT_API_KEY=
# ALLOW_UNGATED_MODELS=false   # development only: skip the gate-run check in config validation
# TYPESAFE_API_KEY=                 # Jev fast path (F033); without it every message takes the LLM path
